# apps/web — control plane env (frontend-specs §8).
# Copy to apps/web/.env.local and fill with real values. NEVER commit secrets.
# Placeholders only here; real provisioning lands in tasks 005 (Cloudflare) / 006 (Supabase).

# --- Supabase (required for the app to boot; auth flows wired in E2) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-side Supabase service-role key (DO NOT prefix NEXT_PUBLIC_). Used by
# privileged route handlers / server actions in later epics.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres / Drizzle (task 006 wires the typed client; placeholder now) ---
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Cloudflare R2 (object storage writes; task 005) ---
# The S3 API token MUST have Object Read & Write on BOTH buckets below.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Two buckets, selected by sites.region (@kept/shared: "auto" | "eu").
# v1 writes to AUTO (region defaults to "auto"); EU is dormant until E8.
R2_BUCKET_AUTO=auto-kept-sites-dev
R2_BUCKET_EU=eu-kept-sites-dev

# --- Cloudflare KV (edge manifest writes via REST; task 005) ---
# Token needs Account → Workers KV Storage → Edit. (Cache Purge added at E1.)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Namespace "kept-manifest-dev" → its ID.
KV_NAMESPACE_ID=your-kv-namespace-id

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
