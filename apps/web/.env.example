# apps/web env template:  cp apps/web/.env.example apps/web/.env.local
# The only env file in the repo. Run scripts via `pnpm --filter @kept/web …`
# so dotenv finds it. Deployed values live in Railway; CI sets its own.
# Local dev uses the DEV stores. NEXT_PUBLIC_* is public and needs a rebuild.
# "rand" = openssl rand -base64 32 (fresh per track, never reuse dev's in prod).

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://localhost:3000   # dev https://app.kept-dev.xyz · prod https://app.kept.host
KEPT_BASE_DOMAIN=kept-dev.xyz                # bare host; prod kept.host
NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_LOCKED_CTA_URL=                # E11 sets it to /founding
NEXT_PUBLIC_KEPT_OPEN=true                   # exactly `true` = open; anything else = closed (prod until launch)
# KEPT_PUBLISH_PAUSED=                        # server-only; exactly `true` = every publish/replace/upload answers 503 publishing_paused (serving, deletes, keeps stay up)

# --- Database (Neon → Branches → dev → Connect) ------------------------------
DATABASE_URL=                                # pooling ON (`-pooler.` host)
MIGRATION_DATABASE_URL=                      # pooling OFF; optional locally (derived from DATABASE_URL)

# --- Auth ----------------------------------------------------------------------
BETTER_AUTH_SECRET=                          # rand
BETTER_AUTH_URL=https://localhost:3000       # same as NEXT_PUBLIC_APP_URL
# GitHub → Settings → Developer settings → OAuth Apps (one app per origin).
# Callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend: verify the domain, then API Keys → sending access) ---------
RESEND_API_KEY=
EMAIL_FROM=                                  # e.g. kept <page@kept-dev.xyz>
KEPT_EMAIL_DELIVERY=                         # `off` skips sending; localhost only, never on Railway

# --- Cloudflare storage & edge -------------------------------------------------
R2_ACCOUNT_ID=                               # dashboard → R2 → Account ID
# R2 → Manage API tokens → Object Read & Write, this track's bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUTO=auto-kept-sites-dev           # prod auto-kept-sites
KV_NAMESPACE_ID=fd5c0c7fbd9147f4849f65d59cdcd14c   # kept-manifest-dev; matches wrangler.toml
# My Profile → API Tokens → Custom, zone = this track's zone only:
# Account·Workers KV Storage·Edit, Zone·Cache Purge·Purge, Zone·Analytics·Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=                          # zone → Overview → API → Zone ID

# --- Abuse & moderation --------------------------------------------------------
OPENROUTER_API_KEY=                          # openrouter.ai/settings/keys, set a credit limit; unset = scanner off
# Turnstile: Cloudflare's always-pass test keys locally. dev/prod: dashboard → Turnstile → Add widget.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
RATE_LIMIT_SECRET=                           # rand
PUBLISHER_HASH_SALT=                         # rand

# --- Admin & access ------------------------------------------------------------
KEPT_ADMIN_EMAILS=                           # comma-separated; the only sign-ins while closed
KEPT_ACCESS_TOKEN_HASHES=                    # comma-separated digests from `pnpm --filter @kept/web admin:token new`
KEPT_ADMIN_SECRET=                           # rand
CRON_SECRET=                                 # rand; same value as the GitHub Environment secret

# Scripts/CI only (pass inline): SMOKE_WEB_URL, SMOKE_EDGE_URL, SMOKE_LEGAL_PLACEHOLDERS,
# CANARY_STATUS, VISITS_CAPTURE_DAY. KEPT_E2E_* are set by playwright.config.ts.
