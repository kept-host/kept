# apps/web — control plane env (frontend-specs §8).
# Copy to apps/web/.env.local and fill with real values. NEVER commit secrets.
# Placeholders only here; real provisioning lands in E02 tasks 002 (Cloudflare),
# 003 (Railway) and 004 (secrets topology).

# --- Neon Postgres / Drizzle ---
# Neon exposes two hostnames for the same database. They share a port; the
# difference is the `-pooler` infix.
#   pooled  ep-xxx-pooler.<region>.aws.neon.tech  -> runtime (PgBouncer, txn mode)
#   direct  ep-xxx.<region>.aws.neon.tech         -> migrations (DDL + advisory locks)
# Runtime MUST use pooled; drizzle-kit MUST use direct.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/kept?sslmode=require
MIGRATION_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kept?sslmode=require

# --- Cloudflare R2 (object storage writes; E02 task 002) ---
# The S3 API token MUST have Object Read & Write on BOTH buckets below.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Two buckets, selected by sites.region (@kept/shared: "auto" | "eu").
# v1 writes to AUTO (region defaults to "auto"); EU is dormant until E11.
# Names are per-track — dev and prod must never share a bucket.
R2_BUCKET_AUTO=auto-kept-sites-dev
R2_BUCKET_EU=eu-kept-sites-dev

# --- Cloudflare KV (edge manifest writes via REST; E02 task 002) ---
# Token needs Account → Workers KV Storage → Edit, plus Cache Purge.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Namespace "kept-manifest-dev" → its ID. Per-track.
KV_NAMESPACE_ID=your-kv-namespace-id

# --- Cloudflare cache purge (E04; docs/edge-purge-contract.md §3) ---
# Zone whose cache the control plane purges after every manifest write:
# kept-dev.xyz on dev, kept.host on prod. 32-char lowercase hex, from the
# Cloudflare dashboard (zone Overview → API → Zone ID) or
# `GET /zones?name=<zone>`. Per-track — the Cache Purge scope on
# CLOUDFLARE_API_TOKEN is already fenced to one zone (E02 task 004), so a dev
# token cannot purge prod. NOT A SECRET, but per-track like everything else.
# Missing ⇒ purge fails as a logged, non-fatal value; publishes still succeed
# and the edge serves the old copy until a retry lands.
CLOUDFLARE_ZONE_ID=

# --- Serving base domain (E04) ---
# The suffix published pages are served from: {slug}.{KEPT_BASE_DOMAIN}. Mirrors
# the Worker var of the same name in apps/edge/wrangler.toml — kept-dev.xyz on
# dev, kept.host on prod. Bare hostname: no scheme, no leading dot, no trailing
# slash. This is NOT NEXT_PUBLIC_APP_URL, which is the control plane's own
# origin; live_url, claim_url and the purge URL forms all need this one. Values
# differ per track so one code path serves both — no hostname literal, no
# NODE_ENV fork (E02's locked decision).
KEPT_BASE_DOMAIN=kept-dev.xyz

# --- Anonymous publish (E04) ---
# Salt for sites.publisher_hash = sha256(salt \n ip \n user-agent), hex. SERVER
# ONLY — never NEXT_PUBLIC_. Lets the control plane scope dedup and E07's rate
# limiter to one publisher WITHOUT retaining visitor IPs: the raw address
# computes the digest and is then discarded, never stored, never logged.
# Per-track value. 32+ random bytes, e.g. `openssl rand -base64 32`.
# ROTATION: changing this invalidates every prior dedup match — a subsequent
# byte-identical publish mints a fresh page instead of deduping. ACCEPTED, not a
# bug: dedup is a convenience for retry loops, not a correctness guarantee.
PUBLISHER_HASH_SALT=

# --- Auth (Better Auth) — slots reserved here, wired in E05 ---
# BETTER_AUTH_SECRET: 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Magic-link email (Resend) — reserved here, wired in E05 ---
RESEND_API_KEY=
EMAIL_FROM=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Disables Next's telemetry beacon. On Railway dev this is load-bearing: an
# outbound packet every few minutes prevents the service from ever sleeping.
NEXT_TELEMETRY_DISABLED=1
